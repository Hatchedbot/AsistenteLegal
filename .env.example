# Copie este archivo como ".env" y complete los valores.
# El archivo .env NO debe subirse al repositorio (ver .gitignore).

# Motor LLM a utilizar: "ollama" (local, sin costo, offline) o "gemini" (API de Google).
LLM_PROVIDER=ollama

# ------------------------------------------------------------------
# Ollama (local)   ->  requiere tener Ollama instalado y el modelo descargado:
#                      ollama pull llama3
# ------------------------------------------------------------------
OLLAMA_MODEL=llama3
# OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------
# Google Gemini (API)
# ------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# Parámetros de generación (aplican a ambos motores)
# ------------------------------------------------------------------
MAX_OUTPUT_TOKENS=4096
